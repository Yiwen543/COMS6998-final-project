(set-logic QF_BV)
(declare-const reset_pin (_ BitVec 1))
(declare-const req (_ BitVec 8))
(declare-const priority_override (_ BitVec 8))
(define-fun reset () Bool (= reset_pin #b1))
(define-fun override_any () Bool (distinct priority_override #x00))
(define-fun req0 () Bool (= ((_ extract 0 0) req) #b1))
(define-fun req1 () Bool (= ((_ extract 1 1) req) #b1))
(define-fun req2 () Bool (= ((_ extract 2 2) req) #b1))
(define-fun req3 () Bool (= ((_ extract 3 3) req) #b1))
(define-fun req4 () Bool (= ((_ extract 4 4) req) #b1))
(define-fun req5 () Bool (= ((_ extract 5 5) req) #b1))
(define-fun req6 () Bool (= ((_ extract 6 6) req) #b1))
(define-fun req7 () Bool (= ((_ extract 7 7) req) #b1))
(define-fun override0 () Bool (= ((_ extract 0 0) priority_override) #b1))
(define-fun override1 () Bool (= ((_ extract 1 1) priority_override) #b1))
(define-fun override2 () Bool (= ((_ extract 2 2) priority_override) #b1))
(define-fun override3 () Bool (= ((_ extract 3 3) priority_override) #b1))
(define-fun override4 () Bool (= ((_ extract 4 4) priority_override) #b1))
(define-fun override5 () Bool (= ((_ extract 5 5) priority_override) #b1))
(define-fun override6 () Bool (= ((_ extract 6 6) priority_override) #b1))
(define-fun override7 () Bool (= ((_ extract 7 7) priority_override) #b1))
(assert (and (not reset) (and (or override_any req7) (not (or override0 (or override1 (or override2 (or override3 (or override4 (or override5 (or override6 override7)))))))))))
(check-sat)
(get-value (reset_pin req priority_override))
