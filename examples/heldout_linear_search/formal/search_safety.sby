[tasks]
bmc
prove
cover

[options]
bmc: mode bmc
bmc: depth 16
prove: mode prove
prove: depth 16
cover: mode cover
cover: depth 24
timeout 60

[engines]
bmc: smtbmc z3
cover: smtbmc z3
prove: abc pdr

[script]
read -formal -sv linear_search_ctrl.sv linear_search_datapath.sv linear_search_top.sv formal_search.sv
prep -top formal_search

[files]
../rtl/linear_search_ctrl.sv
../rtl/linear_search_datapath.sv
../rtl/linear_search_top.sv
formal_search.sv
