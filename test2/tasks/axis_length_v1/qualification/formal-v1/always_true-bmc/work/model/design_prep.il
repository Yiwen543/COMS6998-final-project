  connect \dut.m_ready \dut.dut.m_axis_tready
  connect \dut.m_valid \dut.dut.m_axis_tvalid_reg
  connect \dut.rst \rst
  connect \dut.s_data \s_data
  connect \dut.s_last \dut.dut.s_axis_tlast
  connect \dut.s_ready \dut.dut.s_axis_tready_reg
  connect \dut.s_valid \dut.dut.s_axis_tvalid
  connect \h_ready \dut.dut.status_ready
  connect \h_valid \dut.dut.status_valid_reg
  connect \m_ready \dut.dut.m_axis_tready
  connect \m_valid \dut.dut.m_axis_tvalid_reg
  connect \s_last \dut.dut.s_axis_tlast
  connect \s_ready \dut.dut.s_axis_tready_reg
  connect \s_valid \dut.dut.s_axis_tvalid
end
