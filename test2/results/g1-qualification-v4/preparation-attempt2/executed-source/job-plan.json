{
  "profile": "G1_PUBLIC_SINGLE_PROFILE_V1",
  "order_frozen_before_tools": true,
  "jobs": [
    {
      "id": "compile-icarus-shared",
      "kind": "compile",
      "argv": [
        "/opt/homebrew/bin/iverilog",
        "-v",
        "-g2012",
        "-s",
        "physical_tb",
        "-o",
        "{OUT}/build/physical.vvp",
        "{ROOT}/test2/g1_v4/sources/common.sv",
        "{ROOT}/test2/g1_v4/sources/physical_tb.sv"
      ]
    },
    {
      "id": "compile-verilator-shared",
