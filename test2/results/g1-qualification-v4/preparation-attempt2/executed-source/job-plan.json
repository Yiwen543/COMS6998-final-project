        "/opt/homebrew/bin/verilator",
        "--binary",
        "--timing",
        "--trace",
        "--compiler",
        "clang",
        "--build-jobs",
        "1",
        "--output-split",
        "0",
        "--output-split-cfuncs",
        "0",
        "-Wno-fatal",
        "--top-module",
        "physical_tb",
        "--Mdir",
        "{OUT}/build/verilator",
        "-o",
        "physical_sim",
        "{ROOT}/test2/g1_v4/sources/common.sv",
        "{ROOT}/test2/g1_v4/sources/physical_tb.sv"
      ]
    },
    {
      "id": "QC00-icarus",
      "kind": "physical",
      "qc": "QC00",
      "simulator": "icarus",
      "cycles": 4,
      "argv": [
        "/opt/homebrew/bin/vvp",
        "{OUT}/build/physical.vvp",
        "+QC=0",
        "+TRACE={JOB}/trace.vcd"
      ]
