\\n\\t\\tparameter [0:0]\\tOPT_ASYNC_READ = 1'b1,\\n\\t\\tparameter [0:0]\\tOPT_WRITE_ON_FULL = 1'b0,\\n\\t\\tparameter [0:0]\\tOPT_READ_ON_EMPTY = 1'b0\\n\\t\\t// }}}\\n\\t) (\\n\\t\\t// {{{\\n\\t\\tinput\\twire\\t\\ti_clk,\\n\\t\\tinput\\twire\\t\\ti_reset,\\n\\t\\t//\\n\\t\\t// Write interface\\n\\t\\tinput\\twire\\t\\ti_wr,\\n\\t\\tinput\\twire [(BW-1):0]\\ti_data,\\n\\t\\toutput\\twire \\t\\to_full,\\n\\t\\toutput\\treg [LGFLEN:0]\\to_fill,\\n\\t\\t//\\n\\t\\t// Read interface\\n\\t\\tinput\\twire\\t\\ti_rd,\\n\\t\\toutput\\treg [(BW-1):0]\\to_data,\\n\\t\\toutput\\twire\\t\\to_empty\\t// True if FIFO is empty\\n\\n\\n\\n\\n\\n\\n\\n\\n\\n\\n\\n\\n\\t\\t// }}}\\n\\t);\\n\\n\\t// Register/net declarations\\n\\t// {{{\\n\\tlocalparam\\tFLEN=(1<<LGFLEN);\\n\\treg\\t\\t\\tr_empty;\\n\\twire\\t\\t\\tr_full;\\n\\treg\\t[(BW-1):0]\\tmem[0:(FLEN-1)];\\n\\treg\\t[LGFLEN:0]\\twr_addr, rd_addr;\\n\\n\\twire\\tw_wr = (i_wr && !o_full);\\n\\twire\\tw_rd = (i_rd && !o_empty);\\n\\t// }}}\\n\\t////////////////////////////////////////////////////////////////////////\\n\\t//\\n\\t// Write half\\n\\t// {{{\\n\\t////////////////////////////////////////////////////////////////////////\\n\\t//\\n\\t//\\n\\n\\t// o_fill\\n\\t// {{{\\n\\tinitial\\to_fill = 0;\\n\\talways @(posedge i_clk)\\n\\tif (i_reset)\\n\\t\\to_fill <= 0;\\n\\telse case({ w_wr, w_rd })\\n\\t2'b01: begin\\n\\t\\tif (rd_addr[LGFLEN-1:0] == {LGFLEN{1'b1}})\\n\\t\\t\\to_fill <= o_fill + {(LGFLEN+1){1'b1}};\\n\\t\\telse o_fill <= o_fill - 1;\\n\\tend\\n\\t2'b10: begin\\n\\t\\tif (o_fill == {1'b0, {LGFLEN{1'b1}}}) o_fill <= FLEN;\\n\\t\\telse o_fill <= o_fill + 1;\\n\\tend\\n\\tdefault: begin end // o_fill <= wr_addr - rd_addr;\\n\\tendcase\\n\\t// }}}\\n\\n\\t// r_full, o_full\\n\\t// {{{\\n\\t/*\\n\\tinitial\\tr_full = 0;\\n\\talways @(posedge i_clk)\\n\\tif (i_reset)\\n\\t\\tr_full <= 0;\\n\\telse case({ w_wr, w_rd})\\n\\t2'b01: r_full <= 1'b0;\\n\\t2'b10: r_full <= (o_fill == { 1'b0, {(LGFLEN){1'b1}} });\\n\\tdefault: r_full <= (o_fill == { 1'b1, {(LGFLEN){1'b0}} });\\n\\tendcase\\n\\t*/\\n\\tassign\\tr_full = o_fill[LGFLEN];\\n\\n\\tassign\\to_full = (i_rd && OPT_WRITE_ON_FULL) ? 1'b0 : r_full;\\n\\t// }}}\\n\\n\\t// wr_addr, the write address pointer\\n\\t// {{{\\n\\tinitial\\twr_addr = 0;\\n\\talways @(posedge i_clk)\\n\\tif (i_reset)\\n\\t\\twr_addr <= 0;\\n\\telse case ({ w_wr, w_rd })\\n\\t2'b10: begin\\n\\t\\tif (!(o_fill != {1'b0, {LGFLEN{1'b1}}}))\\n\\t\\t\\twr_addr <= wr_addr - {(LGFLEN+1){1'b1}};\\n\\t\\telse wr_addr <= wr_addr + 1'b1;\\n\\tend\\n\\t2'b11: wr_addr <= wr_addr + 1'b1;\\n\\tdefault: begin end\\n\\tendcase\\n\\t// }}}\\n\\n\\t// Write to memory\\n\\t// {{{\\n\\talways @(posedge i_clk)\\n\\tif (w_wr)\\n\\t\\tmem[wr_addr[(LGFLEN-1):0]] <= i_data;\\n\\t// }}}\\n\\t// }}}\\n\\t////////////////////////////////////////////////////////////////////////\\n\\t//\\n\\t// Read half\\n\\t// {{{\\n\\t////////////////////////////////////////////////////////////////////////\\n\\t//\\n\\t//\\n\\n\\t// rd_addr, the read address pointer\\n\\t// {{{\\n\\tinitial\\trd_addr = 0;\\n\\talways @(posedge i_clk)\\n\\tif (i_reset)\\n\\t\\trd_addr <= 0;\\n\\telse case ({ w_wr, w_rd })\\n\\t2'b01: begin\\n\\t\\tif (!(rd_addr[LGFLEN-1:0] != {LGFLEN{1'b1}}))\\n\\t\\t\\trd_addr <= rd_addr - {(LGFLEN+1){1'b1}};\\n\\t\\telse rd_addr <= rd_addr + 1;\\n\\tend\\n\\t2'b11: rd_addr <= rd_addr + 1;\\n\\tdefault: begin end\\n\\tendcase\\n\\t// }}}\\n\\n\\t// r_empty, o_empty\\n\\t// {{{\\n\\tinitial\\tr_empty = 1'b1;\\n\\talways @(posedge i_clk)\\n\\tif (i_reset)\\n\\t\\tr_empty <= 1'b1;\\n\\telse case ({ w_wr, w_rd })\\n\\t2'b01: r_empty <= (o_fill <= 1);\\n\\t2'b10: begin\\n\\t\\tif (o_fill == {1'b0, {LGFLEN{1'b1}}}) r_empty <= (o_fill == 0);\\n\\t\\telse r_empty <= 1'b0;\\n\\tend\\n\\tdefault: begin end\\n\\tendcase\\n\\n\\tassign\\to_empty = (OPT_READ_ON_EMPTY && i_wr) ? 1'b0 : r_empty;\\n\\t// }}}\\n\\n\\t// Read from the FIFO\\n\\t// {{{\\n\\tgenerate if (OPT_ASYNC_READ && OPT_READ_ON_EMPTY)\\n\\tbegin : ASYNCHRONOUS_READ_ON_EMPTY\\n\\t\\t// o_data\\n\\t\\t// {{{\\n\\t\\talways @(*)\\n\\t\\tbegin\\n\\t\\t\\to_data = mem[rd_addr[LGFLEN-1:0]];\\n\\t\\t\\tif (r_empty)\\n\\t\\t\\t\\to_data = i_data;\\n\\t\\tend\\n\\t\\t// }}}\\n\\tend else if (OPT_ASYNC_READ)\\n\\tbegin : ASYNCHRONOUS_READ\\n\\t\\t// o_data\\n\\t\\t// {{{\\n\\t\\talways @(*)\\n\\t\\t\\to_data = mem[rd_addr[LGFLEN-1:0]];\\n\\t\\t// }}}\\n\\tend else begin : REGISTERED_READ\\n\\t\\t// {{{\\n\\t\\treg\\t\\tbypass_valid;\\n\\t\\treg [BW-1:0]\\tbypass_data, rd_data;\\n\\t\\treg [LGFLEN-1:0]\\trd_next;\\n\\n\\t\\talways @(*)\\n\\t\\t\\trd_next = rd_addr[LGFLEN-1:0] + 1;\\n\\n\\t\\t// Memory read, bypassing it if we must\\n\\t\\t// {{{\\n\\t\\tinitial bypass_valid = 0;\\n\\t\\talways @(posedge i_clk)\\n\\t\\tif (i_reset)\\n\\t\\t\\tbypass_valid <= 0;\\n\\t\\telse if (r_empty || i_rd)\\n\\t\\tbegin\\n\\t\\t\\tif (!i_wr)\\n\\t\\t\\t\\tbypass_valid <= 1'b0;\\n\\t\\t\\telse if (r_empty || (i_rd && (o_fill == 1)))\\n\\t\\t\\t\\tbypass_valid <= 1'b1;\\n\\t\\t\\telse\\n\\t\\t\\t\\tbypass_valid <= 1'b0;\\n\\t\\tend\\n\\n\\t\\talways @(posedge i_clk)\\n\\t\\tif (r_empty || i_rd)\\n\\t\\t\\tbypass_data <= i_data;\\n\\n\\t\\tinitial mem[0] = 0;\\n\\t\\tinitial rd_data = 0;\\n\\t\\talways @(posedge i_clk)\\n\\t\\tif (w_rd)\\n\\t\\t\\trd_data <= mem[rd_next];\\n\\n\\t\\talways @(*)\\n\\t\\tif (OPT_READ_ON_EMPTY && r_empty)\\n\\t\\t\\to_data = i_data;\\n\\t\\telse if (bypass_valid)\\n\\t\\t\\to_data = bypass_data;\\n\\t\\telse\\n\\t\\t\\to_data = rd_data;\\n\\t\\t// }}}\\n\\t\\t// }}}\\n\\tend endgenerate\\n\\t// }}}\\n\\t// }}}\\n////////////////////////////////////////////////////////////////////////////////\\n////////////////////////////////////////////////////////////////////////////////\\n////////////////////////////////////////////////////////////////////////////////\\n//\\n// FORMAL METHODS\\n// {{{\\n////////////////////////////////////////////////////////////////////////////////\\n////////////////////////////////////////////////////////////////////////////////\\n////////////////////////////////////////////////////////////////////////////////\\n//\\n\\n\\n\\n\\n\\n\\n\\n\\n\\n\\n\\n\\n\\n\\n\\n\\n\\n\\n\\n\\n\\n\\n\\n\\n\\n\\n\\n\\n\\n\\n\\n\\n\\n\\n\\n\\n\\n\\n\\n\\n\\n\\n\\n\\n\\n\\n\\n\\n\\n\\n\\n\\n\\n\\n\\n\\n\\n\\n\\n\\n\\n\\n\\n\\n\\n\\n\\n\\n\\n\\n\\n\\n\\n\\n\\n\\n\\n\\n\\n\\n\\n\\n\\n\\n\\n\\n\\n\\n\\n\\n\\n\\n\\n\\n\\n\\n\\n\\n\\n\\n\\n\\n\\n\\n\\n\\n\\n\\n\\n\\n\\n\\n\\n\\n\\n\\n\\n\\n\\n\\n\\n\\n\\n\\n\\n\\n\\n\\n\\n\\n\\n\\n\\n\\n\\n\\n\\n\\n\\n\\n\\n\\n\\n\\n\\n\\n\\n\\n\\n\\n\\n\\n\\n\\n\\n\\n\\n\\n\\n\\n\\n\\n\\n\\n\\n\\n\\n\\n\\n\\n\\n\\n\\n\\n\\n\\n\\n\\n\\n\\n\\n\\n\\n\\n\\n\\n\\n\\n\\n\\n\\n\\n\\n\\n\\n\\n\\n\\n\\n\\n\\n\\n\\n\\n\\n\\n\\n\\n\\n\\n\\n\\n\\n\\n\\n\\n\\n\\n\\n\\n\\n\\n\\n\\n\\n\\n\\n\\n\\n\\n\\n\\n\\n\\n\\n\\n\\n\\n\\n\\n\\n// }}}\\nendmodule\\n`ifndef\\tYOSYS\\n`default_nettype wire\\n`endif\\n\"},\"specification\":\"# Depth-16 synchronous FIFO functional specification\\n\\nParameters: `BW=8`, `LGFLEN=4`, depth 16, asynchronous front read,\\n`OPT_WRITE_ON_FULL=0`, `OPT_READ_ON_EMPTY=0`. Reset is active-high and\\nsynchronous. Each JSON action has exactly `reset`, `wr`, `rd` and 8-bit `data`;\\nit is applied before the next rising edge. The first action resets. Reads and\\nwrites during reset are outside the fixed contract.\\n\\nThe independently expected queue is empty after reset. Before and after\\nevery edge, `o_fill` equals the number of queued words, `o_full` means 16\\nwords, and `o_empty` means zero words. If nonempty, `o_data` equals the oldest\\nqueued word. Empty `o_data` is unspecified. A read is accepted when the\\npre-edge queue is nonempty; a write is accepted when it is not full. During\\nsimultaneous read/write, both may be accepted. At full, only the read is\\naccepted; at empty, only the write is accepted. Accepted operations update\\nthe queue at the rising edge. This contract uses only public I/O, never DUT\\npointer or memory implementation state.\\n\\nThe expected queue behavior includes reset during operation, data order,\\nfull and empty, simultaneous read/write, and continued operation after any\\nnumber of accepted transfers.\\n\"}",
