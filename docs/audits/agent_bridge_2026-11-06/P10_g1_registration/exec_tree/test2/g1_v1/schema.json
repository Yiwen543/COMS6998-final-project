{
  "schema_name": "G1_PROFILE_SPECIFIC_CONTRACT_V1",
  "schema_version": 1,
  "format": "Finite executable policy/row contracts;not a general JSON Schema engine",
  "implementation": [
    "contracts.py:registration_contract",
    "observations.py:parse_rows/parse_vcd/signal/phase_binding",
    "budget.py:Budget"
  ],
  "required_run_header": {
    "schema_name": "g1.public_run_report",
    "schema_version": 1,
    "profile": "G1_PUBLIC_SINGLE_PROFILE_V1",
    "completion128_credit": false
  },
  "row_fields": {
    "qc": "QC00..QC15",
    "cycle": "integer0..3",
    "phase": [
      "pre",
      "post"
    ],
    "tick": "fixed1ps:pre1000+4000*c,post3000+4000*c",
    "q": "four01xzbits",
    "active": "one01xzbit",
    "ok": "one01xzbit",
    "marker": "oneknownbit",
    "a": "fourknownbits",
    "b": "fourknownbits",
    "rst": "oneknownbit",
    "en": "oneknownbit",
    "valid": "oneknownbit"
  },
  "VCD_subset": {
    "max_bytes": 2000000,
    "width_max": 4096,
    "physical_timescale": "1ps",
    "names_widths": "Exact registered suffixes/widths;unrecognized structures fail closed",
    "X_Z": "Preserved/padded using leadingx/z,never filled0"
  },
  "unsupported": [
    "G0/real/legacybundle gate",
    "concurrentdispatch",
    "generalVCD/allSVfrontends",
    "DUToracle/provider/grant authentication",
    "128cycle/unboundedcompletion"
  ],
  "null_policy": "AllR01 actual results/waveforms null/NOT_GENERATED"
}
